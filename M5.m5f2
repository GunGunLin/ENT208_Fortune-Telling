{"version":"V2.0","versionNumber":"V2.4.3","type":"stickc-plus","components":[{"name":"screen","type":"screen","layer":0,"screenId":"builtin","screenName":"","id":"__stickc-plus_screen","createTime":1775791746853,"x":0,"y":0,"width":135,"height":240,"backgroundColor":"#e89898","size":0,"isSelected":true}],"resources":[{"hardware":["hardware_button","hardware_pin_button","imu","speaker","ir"]}],"units":[],"hats":[],"caps":[],"chains":[],"bases":[],"plcmodules":[],"i2cs":[],"chainBus":[],"blockly":"<block type=\"basic_on_setup\" id=\"setup_block\" deletable=\"false\" x=\"50\" y=\"50\"><mutation isBegin=\"true\"></mutation><field name=\"UPDATEOP\">true</field><statement name=\"FUNC\"><block type=\"system_m5_begin\" id=\"o{M!s4Os(YGczE{`4%f0\"></block></statement></block><block type=\"basic_on_loop\" id=\"loop_block\" deletable=\"false\" x=\"450\" y=\"50\"><mutation isUpdate=\"true\"></mutation><field name=\"UPDATEOP\">true</field><statement name=\"FUNC\"><block type=\"system_m5_update\" id=\"QWkZhQQ*k=y+mul]=u_=\"></block></statement></block>","screen":[{"simulationName":"Built-in","type":"builtin","width":135,"height":240,"scale":0.67,"screenName":"","blockId":"","screenColorType":0,"rotation":0,"id":"builtin","createTime":1775791746850}],"logicWhenNum":0,"pythonCode":"import M5\nfrom M5 import Widgets\nfrom hardware import Pin, RGB\nimport time\nimport requests\nimport ujson\nimport network\nimport socket  # 导入 socket 用于 UDP 通信\n\n# === 配置区 ===\nWIFI_SSID = \"OPPO A5\"\nWIFI_PASS = \"lxz599lxz\"\nPC_IP = \"172.20.10.2\"   # 电脑的 IPv4 地址\nUDP_PORT = 12345        # 监听端口\nAPI_KEY = \"sk-jwnmnvbeavdyvzfzewbatzmveutjqxmtlcwokkllagarbdtb\"\nAPI_URL = \"https://api.siliconflow.cn/v1/chat/completions\"\nMODEL_NAME = \"deepseek-ai/DeepSeek-V3\"\n\nPIR_PIN = 33      \nLED_PIN = 32      \nNUM_LEDS = 10     \n\n# --- 联网函数 ---\ndef do_connect(ssid, password):\n    wlan = network.WLAN(network.STA_IF)\n    wlan.active(False) \n    time.sleep_ms(500)\n    wlan.active(True)  \n    if not wlan.isconnected():\n        print('Connecting to network...')\n        try:\n            wlan.disconnect()\n        except:\n            pass\n        wlan.connect(ssid, password)\n        timeout = 0\n        while not wlan.isconnected() and timeout < 20:\n            print('.', end='')\n            time.sleep_ms(500)\n            timeout += 1\n    if wlan.isconnected():\n        print('\\nConnected! IP:', wlan.ifconfig()[0])\n        return True\n    else:\n        print('\\nConnect Failed! status:', wlan.status())\n        return False\n\n# --- 硬件初始化 ---\nM5.begin()\nif do_connect(WIFI_SSID, WIFI_PASS):\n    M5.Lcd.fillScreen(0x00ff00)\n    time.sleep(1)\nelse:\n    M5.Lcd.fillScreen(0xff0000)\n\nM5.Lcd.setRotation(3)\nM5.Lcd.setBrightness(100)\nM5.Lcd.fillScreen(0x000000)\n\npir = Pin(PIR_PIN, mode=Pin.IN)\nled_strip = RGB(io=LED_PIN, n=NUM_LEDS, type=\"SK6812\")\n\ndef get_luckie_fortune():\n    \"\"\"联网从 SiliconFlow 获取 AI 语录\"\"\"\n    payload = {\n        \"model\": MODEL_NAME,\n        \"messages\": [\n            {\n                \"role\": \"system\",\n                \"content\": \"You are a healing robot Luckie-Bot. Provide a 5-word encouraging sentence in English.\"\n            },\n            {\"role\": \"user\", \"content\": \"I am tired.\"}\n        ],\n        \"max_tokens\": 50,\n        \"temperature\": 0.7\n    }\n    headers = {\n        \"Authorization\": f\"Bearer {API_KEY}\",\n        \"Content-Type\": \"application/json\"\n    }\n    try:\n        M5.Lcd.fillScreen(0x000000)\n        M5.Lcd.setCursor(10, 60)\n        M5.Lcd.print(\"Thinking...\")\n        response = requests.post(API_URL, headers=headers, data=ujson.dumps(payload), timeout=8)\n        print(\"HTTP Status Code:\", response.status_code)\n        if response.status_code == 200:\n            res_data = ujson.loads(response.text)\n            return res_data['choices'][0]['message']['content'].strip()\n        else:\n            return \"Err: \" + str(response.status_code)\n    except Exception as e:\n        print(\"Request Failed:\", e)\n        return \"Net Error\"\n\ndef sync_effect():\n    \"\"\"能量同步流光效果\"\"\"\n    for _ in range(2):\n        for i in range(NUM_LEDS):\n            led_strip.fill_color(0x000000)\n            led_strip.set_color(i, 0xffd700) \n            time.sleep_ms(40)\n    led_strip.fill_color(0xbb00ff)\n\n# --- 主逻辑循环 ---\nis_detected = False\nprint(\"Luckie-Bot is Online!\")\n\nwhile True:\n    M5.update() \n\n    # 1. PIR 感应检测\n    if pir.value() == 1:\n        if not is_detected:\n            M5.Lcd.fillScreen(0x000000)\n            M5.Lcd.setCursor(10, 40)\n            M5.Lcd.print(\"HI! Press A\")\n            led_strip.fill_color(0xbb00ff) \n            is_detected = True\n\n        # 2. 检测按键 A 触发 AI 并发送到电脑\n        if M5.BtnA.wasPressed():\n            sync_effect()           \n            quote = get_luckie_fortune() \n\n            # --- 核心：把语录发送给电脑 ---\n            try:\n                # 创建 UDP 对讲机\n                udp_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n                msg = \"QUOTE:\" + quote\n                # 发送至 PC_IP (172.20.10.2)\n                udp_sock.sendto(msg.encode('utf-8'), (PC_IP, UDP_PORT))\n                print(\"✅ Done! Sent to PC:\", msg)\n                udp_sock.close() # 释放资源\n            except Exception as e:\n                print(\"❌ Send Error:\", e)\n\n            # M5 本地显示语录\n            M5.Lcd.fillScreen(0xbb00ff)\n            M5.Lcd.setCursor(5, 20)\n            M5.Lcd.print(\"Luckie-Bot says:\")\n            M5.Lcd.setCursor(5, 50)\n            M5.Lcd.print(quote)\n            \n            print(f\"Quote: {quote}\")\n            time.sleep(6) \n            is_detected = False \n\n    else:\n        # 没人时熄灭\n        if is_detected:\n            M5.Lcd.fillScreen(0x000000)\n            M5.Lcd.setCursor(10, 60)\n            M5.Lcd.print(\"Zzz...\")\n            led_strip.fill_color(0x000000)\n            is_detected = False\n\n    time.sleep_ms(100)","customList":[]}